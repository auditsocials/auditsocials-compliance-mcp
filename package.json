{
  "name": "auditsocials-compliance-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.eminegurcu/auditsocials-compliance-mcp",
  "description": "MCP server that checks AI-generated social media content against live platform policy across 8 platforms (Meta, TikTok, LinkedIn, Google Ads, YouTube, X, Snapchat, Pinterest) before it's published — so posts, accounts and ads aren't flagged, demonetized or banned.",
  "type": "module",
  "license": "MIT",
  "author": "Emine Gürcü (Product Lead, AuditSocials)",
  "homepage": "https://www.auditsocials.com/compliance-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auditsocials/auditsocials-compliance-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "compliance",
    "content-moderation",
    "advertising-policy",
    "platform-policy",
    "social-media",
    "ai-content",
    "guardrail",
    "auditsocials"
  ],
  "bin": {
    "auditsocials-compliance-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
